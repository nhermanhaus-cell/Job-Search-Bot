DATABASE_URL="file:../.data/app.db"
PORT=3000
PUBLIC_URL=http://localhost:3000

# Mail classifier. gpt-4o-mini is the default for this build.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Cloud OAuth client (Web application)
# Authorized redirect URI: http://localhost:3000/api/mail/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

MAIL_TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-string
MAIL_POLL_MS=900000

# Job sources (optional; Demo, Remotive, and Remote OK work without keys)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
JSEARCH_API_KEY=
JOOBLE_API_KEY=

# Public company ATS feeds; comma-separated company slugs
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=
JOB_REFRESH_MS=14400000
