# Job Hunt OS — environment template
DATABASE_URL="postgresql://jobhunt:jobhunt@localhost:5432/jobhunt"
DIRECT_DATABASE_URL="postgresql://jobhunt:jobhunt@localhost:5432/jobhunt"
PORT=3000
PUBLIC_URL=http://localhost:3000
NODE_ENV=development

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Native Sign in with Apple / Google (not Gmail). Skip these while using guest mode.
AUTH_JWT_SECRET=change-me-auth-jwt-secret
AUTH_ISSUER=job-hunt-os
APPLE_CLIENT_IDS=com.jobhuntos.app,com.jobhuntos.mac
# Paid Apple Developer account: Membership details → Team ID
APPLE_TEAM_ID=
# Certificates, Identifiers & Profiles → Keys → Sign in with Apple (download the .p8 once)
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_SERVER_CLIENT_IDS=
GOOGLE_IOS_CLIENT_ID=
# Local/dev default is on. Production stays off unless you set this to true.
ALLOW_GUEST_AUTH=true

# Gmail readonly OAuth (optional tracker — not Google Sign-In).
# Create a Web client in Google Cloud Console. Redirect URI:
#   {PUBLIC_URL}/api/mail/google/callback
# Local: http://localhost:3000/api/mail/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Keep false until Google verifies gmail.readonly for public users.
# Local development still allows Connect Gmail when the two values above are set.
GMAIL_PUBLIC_ENABLED=false
# Optional. projects/<id>/topics/<name> for Gmail push. Empty = poll only.
GMAIL_PUBSUB_TOPIC=

MAIL_TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-string
OBJECT_ENCRYPTION_KEY=change-me-object-wrapping-key
BUCKET_NAME=job-hunt-os
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

ALLOWED_ORIGINS=
SENTRY_DSN=
DATA_DIR=./.data

# Job sources. Remotive, Remote OK, and demo work with no keys.
# After editing this file, stop npm run dev and start it again.
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# USAJOBS: https://developer.usajobs.gov/APIRequest/Index
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# JSearch on RapidAPI: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=
# Company boards are easier to set in the Mac app (Settings → Company boards).
# Optional server-wide defaults: comma-separated slugs or careers URLs.
# Greenhouse: stripe,airbnb,figma,databricks,cloudflare,reddit,robinhood
# Lever: palantir,spotify,wealthfront
# Ashby: openai,notion,cursor,linear,ramp,perplexity
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=
JOB_REFRESH_MS=14400000
