# Job Hunt OS — environment template
DATABASE_URL="postgresql://jobhunt:jobhunt@localhost:5432/jobhunt"
DIRECT_DATABASE_URL="postgresql://jobhunt:jobhunt@localhost:5432/jobhunt"
PORT=3000
PUBLIC_URL=http://localhost:3000
NODE_ENV=development

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Native Sign in with Apple / Google (not Gmail)
AUTH_JWT_SECRET=change-me-auth-jwt-secret
AUTH_ISSUER=job-hunt-os
APPLE_CLIENT_IDS=com.jobhuntos.app,com.jobhuntos.mac
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_SERVER_CLIENT_IDS=
GOOGLE_IOS_CLIENT_ID=
# Local/dev default is on. Production stays off unless you set this to true.
ALLOW_GUEST_AUTH=true

# Gmail readonly OAuth (feature-flagged in production until Google verification)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_PUBLIC_ENABLED=false
GMAIL_PUBSUB_TOPIC=

MAIL_TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-string
OBJECT_ENCRYPTION_KEY=change-me-object-wrapping-key
BUCKET_NAME=job-hunt-os
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

ALLOWED_ORIGINS=
SENTRY_DSN=
DATA_DIR=./.data

# Job sources. Remotive, Remote OK, and demo work with no keys.
# After editing this file, stop npm run dev and start it again.
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# USAJOBS: https://developer.usajobs.gov/APIRequest/Index
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# JSearch on RapidAPI: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=
# Public ATS boards (not API keys). Comma-separated slugs, e.g. stripe,notion
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=
JOB_REFRESH_MS=14400000
