{
  "name": "job-hunt-os-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "start": "tsx src/index.ts",
    "start:worker": "tsx src/worker.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "migrate:local": "tsx --env-file=.env scripts/migrate-local.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/lib-storage": "^3.1126.0",
    "@hono/node-server": "^1.19.1",
    "@prisma/client": "^6.15.0",
    "@sentry/node": "^10.73.0",
    "google-auth-library": "^11.0.2",
    "googleapis": "^159.0.0",
    "hono": "^4.9.8",
    "jose": "^6.2.10",
    "mammoth": "^1.12.2",
    "openai": "^5.20.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
